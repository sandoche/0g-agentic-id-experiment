# Copy to an ignored .env.minimal only if it does not already exist.
# Do not replace your portfolio .env. Process environment takes precedence.
AGENT_PROFILE=minimal
# Explicitly choose your intended environment before any online operation:
# mainnet: https://agenticid-mainnet.0g.ai (real OG, chain 16661)
# testnet: https://agenticid.0g.ai (testnet OG, chain 16602)
# Absent/blank retains the existing mainnet default; the CLI resolves identity
# from the attestor /config and checks the RPC chain ID.
AGENTIC_ATTESTOR_URL=
INFERENCE_MODEL=glm-5.3
# Private/TeeML inference credential; needed for deploy, not offline check/status.
AGENT_API_KEY=
# Owner wallet; needed for deployment, funding and persistence owner requests.
OWNER_PRIVATE_KEY=
