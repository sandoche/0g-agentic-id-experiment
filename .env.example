# EXAMPLE ONLY: replace these sample allocations and prompt in your ignored .env.
# Never commit .env or paste credentials into chat.

# 1inch Business Portal -> Applications -> API key
# https://business.1inch.com/portal/
ONEINCH_API_KEY=

# 0G Private Computer -> API keys -> set Trust Mode to Private (TeeML only).
# Inference key; separate from a wallet private key. Model selection alone
# does not guarantee enclave inference. Never use Verified/Standard fallback.
# https://pc.0g.ai/dashboard/api-keys
AGENT_API_KEY=

# Local owner wallet used to mint/manage the INFT. Never sent to the worker.
# Leave empty until you are ready to mint. Format: 0x followed by 64 hex digits.
OWNER_PRIVATE_KEY=
# 0G mainnet (16661) by default: protocol transactions spend real OG.
# For 0G testnet (16602), use https://agenticid.0g.ai instead.
AGENTIC_ATTESTOR_URL=https://agenticid-mainnet.0g.ai
# Verified in the public 0G catalog: TeeML / TDX, with tool calling.
# https://docs.0g.ai/developer-hub/building-on-0g/compute-network/router/privacy
INFERENCE_MODEL=glm-5.3

# Simulation disables investment transactions; explicit protocol commands still spend OG.
TRADING_MODE=simulation
REBALANCE_INTERVAL_MS=300000
MAX_SLIPPAGE_BPS=50
DRIFT_THRESHOLD_BPS=100
MIN_TRADE_USD=5

# Base by default; 42161 selects Arbitrum. Ethereum mainnet is forbidden.
FUNDING_CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BNB_RPC_URL=https://bsc-dataseed.bnbchain.org

# SAMPLE equal weights: 100 basis points = 1%; total must be 10000.
# These are example values, not the private strategy or investment advice.
PORTFOLIO_ALLOCATIONS='[{"symbol":"NVDA","chainId":4663,"weightBps":1250},{"symbol":"MSFT","chainId":4663,"weightBps":1250},{"symbol":"GOOGL","chainId":4663,"weightBps":1250},{"symbol":"AMZN","chainId":4663,"weightBps":1250},{"symbol":"AVGO","chainId":4663,"weightBps":1250},{"symbol":"TAO","chainId":4663,"weightBps":1250},{"symbol":"0G","chainId":56,"weightBps":1250},{"symbol":"FET","chainId":56,"weightBps":1250}]'
STRATEGY_PROMPT='Example: follow the configured demonstration allocations, check every five minutes, and report skipped trades without changing target weights. Never use Ethereum mainnet.'
